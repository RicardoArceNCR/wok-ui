      "hover": {
        "$type": "color",
        "$value": "{brand.support}"
      },
      "active": {
        "$type": "color",
        "$value": "{brand.support}"
      }
    },
    "height": {
      "$type": "dimension",
      "$value": "{spacing.16}"
    }
