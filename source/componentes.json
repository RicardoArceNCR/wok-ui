        "$type": "color",
        "$value": "{feedback.warning.text}"
      }
    },
    "error": {
      "bg": {
        "$type": "color",
        "$value": "{feedback.error.bg}"
      },
      "text": {
        "$type": "color",
        "$value": "{feedback.error.text}"
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "sm": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.2}"
      }
    },
    "md": {
      "padding-x": {
        "$type": "dimension",
        "$value": "{spacing.3}"
      }
    }
