{
  "button": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{brand.action}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{brand.action-hover}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{brand.action-press}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.on-brand}"
      },
      "border": {
        "$type": "color",
        "$value": "{brand.action}"
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": "{surface.base}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{background.subtle}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{background.strong}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.primary}"
      },
      "border": {
        "$type": "color",
        "$value": "{text.primary}"
      }
    },
    "ghost": {
      "bg": {
        "$type": "string",
        "$value": "rgba(0, 0, 0, 0)"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{background.subtle}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{background.strong}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.primary}"
      },
      "border": {
        "$type": "string",
        "$value": "rgba(0, 0, 0, 0)"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.700}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.danger.800}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{color.danger.900}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.on-brand}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.danger.700}"
      }
    },
    "disabled": {
      "bg": {
        "$type": "color",
        "$value": "{background.strong}"
      },
      "text": {
        "$type": "color",
        "$value": "{text.disabled}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.subtle}"
      }
    },
    "size": {
      "sm": {
        "height": {
          "$type": "dimension",
          "$value": "{spacing.8}"
        },
        "padding-x": {
          "$type": "dimension",
          "$value": "{spacing.3}"
        }
      },
      "md": {
        "height": {
          "$type": "dimension",
          "$value": "{spacing.10}"
        },
        "padding-x": {
          "$type": "dimension",
          "$value": "{spacing.4}"
        }
      },
      "lg": {
        "height": {
          "$type": "dimension",
          "$value": "{spacing.12}"
        },
        "padding-x": {
          "$type": "dimension",
          "$value": "{spacing.6}"
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "font-weight": {
      "$type": "float",
      "$value": "{typography.weight.bold}"
    },
    "letter-spacing": {
      "$type": "float",
      "$value": "{typography.tracking.caps}"
    }
  },
  "input": {
    "bg": {
      "$type": "color",
      "$value": "{surface.base}"
    },
    "bg-focus": {
      "$type": "color",
      "$value": "{surface.base}"
    },
    "bg-disabled": {
      "$type": "color",
      "$value": "{background.subtle}"
    },
    "border": {
      "$type": "color",
      "$value": "{border.strong}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{border.brand}"
    },
    "border-focus": {
      "$type": "color",
      "$value": "{brand.action}"
    },
    "border-error": {
      "$type": "color",
      "$value": "{feedback.error.icon}"
    },
    "border-success": {
      "$type": "color",
      "$value": "{feedback.success.icon}"
    },
    "border-disabled": {
      "$type": "color",
      "$value": "{border.subtle}"
    },
    "text": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "text-disabled": {
      "$type": "color",
      "$value": "{text.disabled}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{text.tertiary}"
    },
    "label": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "padding-x": {
      "$type": "dimension",
      "$value": "{spacing.4}"
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{spacing.3}"
    }
  },
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{surface.raised}"
    },
    "bg-hover": {
      "$type": "color",
      "$value": "{surface.subtle}"
    },
    "border": {
      "$type": "color",
      "$value": "{border.default}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{border.strong}"
    },
    "text": {
      "$type": "color",
      "$value": "{text.primary}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.6}"
    },
    "shadow": {
      "$type": "string",
      "$value": "{shadow.sm}"
    }
  },
  "nav": {
    "bg": {
      "$type": "color",
      "$value": "{surface.ink}"
